{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "explabs": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Experiential Labs",
      "options": {
        "baseURL": "https://api.experientiallabs.ai/v1",
        "apiKey": "{env:EXPLABS_API_KEY}"
      },
      "models": {
        "claude-sonnet-5": {
          "name": "claude-sonnet-5",
          "limit": {
            "context": 1000000,
            "output": 128000
          },
          "cost": {
            "input": 2,
            "output": 10
          }
        },
        "gpt-5.4-mini": {
          "name": "gpt-5.4-mini",
          "limit": {
            "context": 400000,
            "output": 128000
          },
          "cost": {
            "input": 0.75,
            "output": 4.5
          }
        },
        "gemini-3.5-flash": {
          "name": "gemini-3.5-flash",
          "limit": {
            "context": 1048576,
            "output": 65536
          },
          "cost": {
            "input": 1.5,
            "output": 9
          }
        },
        "deepseek-v4-flash": {
          "name": "deepseek-v4-flash",
          "limit": {
            "context": 1048576,
            "output": 384000
          },
          "cost": {
            "input": 0.042448,
            "output": 0.084896
          }
        }
      }
    }
  }
}
