# Hastama environment configuration — copy to .env and fill in every value.
# The file is loaded by app/core/config.py; never commit the real .env.
#
# Generate the values with:
#   python -c "import secrets; print(secrets.token_hex(48))"   # session key
#   python -c "import secrets; print(secrets.token_hex(32))"   # HMAC secret
#
# The application refuses to start with DEBUG=False when no stable session
# signing key is configured.

# ── Core ─────────────────────────────────────────────────────────────────────
# Session signing key (either name works; SESSION_SECRET_KEY wins).
SESSION_SECRET_KEY=
SECRET_KEY=

# Debug mode — MUST be False in production.
DEBUG=False

# ── Secrets ──────────────────────────────────────────────────────────────────
# HMAC key for one-time password recovery codes.  When it is empty the recovery
# flow is disabled and fails closed (no codes are issued).
HASTAMA_HMAC_SECRET=

# Araz / T7 device bridge secret shared with tools/bridge_agent.py.
# POST /api/araz/bridge-sync answers 503 while this is empty.
ARAZ_BRIDGE_SECRET=

# Password of the Access database (database/Arazdb.mdb).  Leave empty only when
# the MDB is not password protected; the deployment checklist requires one.
ARAZ_ACCESS_PASSWORD=
ARAZ_ACCESS_PATH=E:\Hastama\database\Arazdb.mdb

# ── Network / proxy ──────────────────────────────────────────────────────────
# Addresses whose X-Forwarded-For / X-Forwarded-Proto headers are believed.
# Default (loopback only) matches the supported deployment: Caddy and uvicorn on
# the same host.  Only widen this when a reverse proxy runs on another machine.
TRUSTED_PROXY_IPS=127.0.0.1,::1

# Session lifetime in seconds (default 8 hours) — idle timeout is 30 minutes.
SESSION_MAX_AGE_SECONDS=28800

# ── Application ──────────────────────────────────────────────────────────────
# Comma separated list of usernames that receive the master-admin console.
MASTER_ADMIN_USERNAMES=ali

# Where ticket attachments are stored (outside /static, never web served).
TICKETING_PRIVATE_DIR=app/private_uploads/tickets

MODEL_PATH=./ml/model/
MODEL_NAME=model.pkl
MEMOIZATION_FLAG=True
